<!doctype html>
<html lang="{{ page.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  {# vite-ignore: Vite would otherwise hash the feed into /assets/ and break its URL. #}
  <link rel="alternate" type="application/atom+xml" href="/{{ page.lang }}/feed.xml" title="{{ site.name }}" vite-ignore>
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
    <link rel="stylesheet" href="/assets/css/app.css">
<script type="module" src="/assets/js/app.js"></script>
  {% if structuredData %}<script type="application/ld+json">{{ structuredData | jsonLd | safe }}</script>{% endif %}
</head>
<body>
  <a href="#main" class="sr-only focus:not-sr-only">{{ "skipLink" | t }}</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
</body>
</html>
