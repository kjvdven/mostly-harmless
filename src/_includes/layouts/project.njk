---
layout: default.njk
---
<article class="layout py-8 flow">
  <header class="flow flow-sm">
    <h1>{{ title }}</h1>
    <p>{{ description }}</p>
    <dl>
      <dt>{{ "role" | t }}</dt>
      <dd>{{ role }}</dd>
      <dt>{{ "stack" | t }}</dt>
      <dd>{{ stack | join(", ") }}</dd>
      <dt>{{ "year" | t }}</dt>
      <dd>{{ year }}</dd>
    </dl>
    {% if links.live or links.repo %}
    <ul role="list">
      {% if links.live %}<li><a href="{{ links.live }}">{{ "visitSite" | t }}</a></li>{% endif %}
      {% if links.repo %}<li><a href="{{ links.repo }}">{{ "viewCode" | t }}</a></li>{% endif %}
    </ul>
    {% endif %}
  </header>

  {{ content | safe }}
</article>
