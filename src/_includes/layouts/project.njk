---
layout: default.njk
---
<article class="layout py-8 flow">
  <header class="flow flow-sm">
    <h1>{{ title }}</h1>
    <p>{{ description }}</p>
    <dl>
      <dt>Role</dt>
      <dd>{{ role }}</dd>
      <dt>Stack</dt>
      <dd>{{ stack | join(", ") }}</dd>
      <dt>Year</dt>
      <dd>{{ year }}</dd>
    </dl>
    {% if links.live or links.repo %}
    <ul role="list">
      {% if links.live %}<li><a href="{{ links.live }}">Visit the site</a></li>{% endif %}
      {% if links.repo %}<li><a href="{{ links.repo }}">View the code</a></li>{% endif %}
    </ul>
    {% endif %}
  </header>

  {{ content | safe }}
</article>
