<header>
  <a href="/{{ page.lang }}/">Mostly Harmless</a>
  <nav aria-label="{{ 'mainNav' | t }}">
    <ul role="list">
      {% for item in [
        { key: "blog", url: "/" ~ page.lang ~ "/blog/" },
        { key: "patterns", url: "/" ~ page.lang ~ "/patterns/" },
        { key: "projects", url: "/" ~ page.lang ~ "/projects/" },
        { key: "about", url: "/" ~ page.lang ~ "/about/" }
      ] %}
      {# startsWith: a case study keeps "Projects" marked as the current section. #}
      <li><a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="{{ 'page' if page.url == item.url else 'true' }}"{% endif %}>{{ item.key | t }}</a></li>
      {% endfor %}
    </ul>
  </nav>
</header>
