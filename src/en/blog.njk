---
title: Blog
layout: default.njk
---
<div class="layout py-8 flow">
  <h1>{{ title }}</h1>
  <p><a href="/{{ page.lang }}/feed.xml">{{ "followFeed" | t }}</a></p>

  <ul role="list" class="flow">
    {% for post in collections.blog | reverse %}
    <li>
      <article>
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        <time datetime="{{ post.date.toISOString() }}">{{ post.date | readableDate }}</time>
        {% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
      </article>
    </li>
    {% endfor %}
  </ul>
</div>
