---
title: Card demo
layout: default.njk
---

<div class="layout py-8">
  <h1 class="text-3xl font-bold">Card demo</h1>

  {# role="list": without list-style Safari/VoiceOver would drop the list semantics. #}
  <ul role="list" class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {% for card in [
      { title: "Don't panic", tag: "guide" },
      { title: "Mostly harmless", tag: "earth" },
      { title: "So long, and thanks for all the fish", tag: "dolphins" }
    ] %}
    <li>
      <article class="link-box flow flow-sm bg-slate-100 p-4">
        <div class="overflow-hidden">
          {# Decorative here: the title already names the card. #}
          <img src="./blog/spike.jpg" alt="" class="w-full motion-safe:transition-transform link-box-hover:scale-105">
        </div>
        <h2 class="text-xl font-bold">
          <a href="/en/blog/2026-10-25-spike/" class="link-overlay link-box-hover:underline">{{ card.title }}</a>
        </h2>
        <p>The whole card is clickable, but there is only one link: the title.</p>
        <a href="/en/feed.xml" class="text-sm underline">#{{ card.tag }}</a>
        <button type="button" class="flow-start-none absolute top-2 right-2 bg-white px-2 text-sm" aria-label="Save {{ card.title }}">Save</button>
      </article>
    </li>
    {% endfor %}
  </ul>
</div>
